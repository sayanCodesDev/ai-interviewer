# Copy to frontend/.env (development) or frontend/.env.production (deployed build). Values are inlined at build time.
VITE_BACKEND_URL=http://localhost:2000        # the API origin. Use https:// in production.
VITE_SITE_URL=https://your-domain.example      # this site's public origin: canonical URLs, sitemap, social previews
VITE_CONTACT_EMAIL=                            # optional: shown on the privacy page
