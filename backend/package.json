{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "prestart": "prisma generate && prisma migrate deploy",
    "start": "tsx src/index.ts",
    "test": "NODE_ENV=test tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "predev": "prisma generate && prisma migrate deploy",
    "dev": "tsx watch src/index.ts",
    "pretest": "prisma generate && tsx scripts/prepare-test-db.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.20.0",
    "pino-pretty": "^13.1.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.4.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "opusscript": "^0.1.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.0",
    "prom-client": "^15.1.3",
    "tsx": "^4.22.4",
    "unpdf": "^1.8.1",
    "werift": "^0.24.4",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  }
}
