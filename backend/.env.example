# Copy to backend/.env and fill in. Nothing here is committed with real values.
# Every variable is validated at boot; in production the server refuses to start if a required one is missing.

# ---- Core -------------------------------------------------------------------------------------
NODE_ENV=development            # development | production | test
PORT=2000
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# ---- Database (PostgreSQL) --------------------------------------------------------------------
# Neon: use the pooled (-pooler) connection string. Migrations run automatically on `npm start` / `npm run dev`
# (prisma migrate deploy: only applies what is missing, never resets anything).
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_POOL_MAX=10            # (instances x this) must stay below your database's connection limit
# Tests only ever touch this, and it must be a local database. `npm test` creates and migrates it.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5544/ai_interviewer_test

# ---- Security ---------------------------------------------------------------------------------
JWT_SECRET=                     # required in production, at least 32 random characters: openssl rand -hex 32
ALLOWED_ORIGINS=http://localhost:3000   # comma-separated origins allowed to call the API (your frontend URL(s))
TRUST_PROXY=                    # number of reverse proxies in front of the API (1 behind nginx/ALB), so rate limits see real IPs
COOKIE_SAMESITE=lax             # lax | strict | none. Frontend and API on the same site (app.x.com + api.x.com): lax.
                                # Different sites: none (needs HTTPS on the API; Safari may still block it).
COOKIE_DOMAIN=                  # e.g. .example.com to share the sign-in cookie between app. and api.
METRICS_TOKEN=                  # set to enable GET /metrics (Prometheus) for a caller sending "Authorization: Bearer <token>"

# ---- Voice: speech to text and text to speech (Deepgram) --------------------------------------
DEEPGRAM_API_KEY=               # required in production
# "text" skips speech entirely: the interview runs over the data channel and you type. Development and tests only.
VOICE_MODE=live

# ---- Language model (any OpenAI-compatible chat API; defaults to Groq) ------------------------
GROQ_API_KEY=                   # required in production (or LLM_API_KEY)
GROQ_MODEL=qwen/qwen3.8-27b     # the interviewer: fast, no reasoning
GROQ_EVAL_MODEL=openai/gpt-oss-120b   # scoring: stronger
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b   # tried in order when a model is rate limited
# Move to another provider without code changes:
LLM_BASE_URL=                   # e.g. https://api.openai.com/v1
LLM_API_KEY=
LLM_TPM_LIMIT=8000              # tokens per minute per model. FREE GROQ KEYS ALSO HAVE A DAILY LIMIT (200,000 tokens per
                                # model per day), roughly three full interviews. Use a paid tier for real traffic.
GITHUB_TOKEN=                   # optional: lifts GitHub's 60 requests/hour limit when reading candidates' public repos

# ---- Code sandbox -----------------------------------------------------------------------------
CODE_RUNNER=auto                # auto | docker | local. `local` runs candidate code on this machine (development only).
RUNNER_IMAGE=ai-interviewer-runner:latest   # build once: docker build -t ai-interviewer-runner:latest backend/runner
RUNNER_CONCURRENCY=4            # code runs at once on this instance
RUNNER_MEMORY_MB=256
RUNNER_CPUS=1
ALLOW_UNSAFE_LOCAL_EXEC=false   # production refuses CODE_RUNNER=local unless this is true. Don't.

# ---- Capacity and limits ----------------------------------------------------------------------
MAX_CONCURRENT_INTERVIEWS=20    # live calls per instance; more get a 503 with Retry-After
MAX_INTERVIEWS_PER_DAY=5        # per user; protects your model and speech spend. 0 = unlimited.
DATA_RETENTION_DAYS=180         # interviews (with transcripts, code, reports) older than this are deleted. 0 = keep forever.
REPORT_WORKER_ENABLED=true      # every instance can run one; jobs are claimed with FOR UPDATE SKIP LOCKED

# ---- WebRTC (needed when the server is behind NAT, e.g. any cloud VM) -------------------------------
WEBRTC_PUBLIC_IP=               # the server's public IPv4, advertised to browsers
WEBRTC_PORT_MIN=                # UDP port range for media; open exactly this range in your firewall / security group
WEBRTC_PORT_MAX=
STUN_URLS=                      # optional, comma-separated: stun:stun.l.google.com:19302
